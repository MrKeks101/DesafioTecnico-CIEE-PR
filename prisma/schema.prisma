generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// Modelo de candidato — ver docs/requirements/cadastro-de-candidatos.md
// ("Modelo de dados") e specs.md linha 34 ("Scripts ou migrations para
// criar a estrutura do banco"). Nomes de campo casam com o schema Zod
// compartilhado em packages/shared/src/candidate.ts.
model Candidate {
  id             Int      @id @default(autoincrement())
  fullName       String
  email          String
  phone          String?
  areaOfInterest String?
  // nvarchar(1000) default do provider sqlserver truncaria resumos longos.
  summary        String?  @db.NVarChar(Max)
  createdAt      DateTime @default(now())
}
