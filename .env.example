# Copie este arquivo para ".env" e ajuste os valores. Nunca commitar o ".env" real.

# Senha do usuário "sa" do SQL Server (container docker-compose). Use uma senha
# forte local; não é uma credencial real de produção.
MSSQL_SA_PASSWORD=Your_strong_password123

# String de conexão usada pelo Prisma (backend).
DATABASE_URL="sqlserver://localhost:1433;database=desafio_ciee;user=sa;password=Your_strong_password123;trustServerCertificate=true"

# Porta em que a API backend escuta.
PORT=3001
